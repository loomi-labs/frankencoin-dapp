NEXT_PUBLIC_LANDINGPAGE_URL=https://frankencoin.com
NEXT_PUBLIC_APP_URL=https://app.frankencoin.com
NEXT_PUBLIC_API_URL=https://api.frankencoin.com
NEXT_PUBLIC_PONDER_URL=https://ponder.frankencoin.com

NEXT_PUBLIC_PROFILE=testnet
NEXT_PUBLIC_WAGMI_ID=...
NEXT_PUBLIC_RPC_KEY=...
NEXT_PUBLIC_BOT_NAME=...

NEXT_PUBLIC_UMAMI_URL=https://umami.odincloud.xyz
NEXT_PUBLIC_UMAMI_WEBSITE_ID=...

# Set to "true" to show the hosting-provider disruption banner on the loading screen.
NEXT_PUBLIC_SHOW_DISRUPTION_BANNER=

# Enso swap execution on the migration page — toggled per-session in the UI, see utils/enso.ts.
# ENSO_API_KEY is server-only: never prefix it with NEXT_PUBLIC_, it must not reach the browser bundle.
ENSO_API_KEY=
